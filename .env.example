# Email-only setup for Contact/Internship forms. Resend sends form notifications
# https://resend.com

ACS_RESEND_API_KEY=re_your_api_key_here

# From display name — keep quoted so Gmail shows "Aryan Cyber Solutions"
ACS_RESEND_FROM_EMAIL="Aryan Cyber Solutions <onboarding@resend.dev>"

# Company inbox for all Contact + Internship form emails
ACS_CONTACT_TO_EMAIL=sriaryan.dev@gmail.com

# ── Training Assessment ──────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster is sufficient)
# https://cloud.mongodb.com → Create Project → Build Database → Free M0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.zqc6ck0.mongodb.net/acs_training?retryWrites=true&w=majority

# Admin inbox for new training assessment submissions
ACS_TRAINING_ADMIN_EMAIL=sriaryan.dev@gmail.com

# Current cohort year — used to scope candidate IDs (e.g. ACS-2026-000001)
TRAINING_COHORT_YEAR=2026

# Assessment Access Window in IST (24h format: 16 = 4:00 PM, 24 = 12:00 AM Midnight)
ASSESSMENT_START_HOUR=16
ASSESSMENT_END_HOUR=24

# Development rate limit override (production is strictly 5/hour)
TRAINING_REGISTER_RATE_LIMIT=50

# Security
# Strong random string for JWT session signing. Required in production.
JWT_SECRET=generate_a_secure_random_string_here
